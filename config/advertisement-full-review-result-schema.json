{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["r"],
  "properties": {
    "r": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["i", "l", "x"],
        "properties": {
          "i": {"type": "integer", "minimum": 0},
          "l": {"type": "integer", "enum": [0, 1, 2]},
          "x": {"type": "string"}
        }
      }
    }
  }
}
