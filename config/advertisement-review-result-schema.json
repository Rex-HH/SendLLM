{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["r"],
  "properties": {
    "r": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["i", "l", "x", "s"],
        "properties": {
          "i": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "l": {
            "type": "integer",
            "enum": [0, 1, 2]
          },
          "x": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9_]*$"
          },
          "s": {
            "type": "integer",
            "enum": [0, 1]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "l": {"const": 1}
              },
              "required": ["l"]
            },
            "then": {
              "properties": {
                "x": {"const": ""}
              }
            }
          }
        ]
      }
    }
  }
}
